<!--
  The one part of the updater that source sharing cannot carry: manifest entries
  merge from library modules, and the updater is not one — it is sources compiled
  straight into the app. Paste these into the host app's AndroidManifest.xml.

  ${applicationId} is substituted by the build, so this text is the same in every
  project: two apps on one phone cannot claim the same provider authority, and
  these apps sit on the same phone.

  The provider is dev.updater.UpdaterFileProvider and not FileProvider itself:
  several of these apps already declare androidx.core.content.FileProvider for
  their own sharing, and a manifest names each component once.
-->

<!-- Beside the other <uses-permission> lines -->
<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

<!-- On <application>, unless the app already names a config of its own -->
<application
    android:networkSecurityConfig="@xml/updater_network_security_config">

    <!-- Inside <application> -->
    <provider
        android:name="dev.updater.UpdaterFileProvider"
        android:authorities="${applicationId}.updater.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/updater_file_paths" />
    </provider>

</application>
